<Project>
  <!--
    Umbraco 17 and 18 both run on net10.0, so one build of this package serves both. It is
    compiled against the lowest supported versions and published with dependency ranges that
    stop short of 19, so a site on either major can install it.

    CI (and anyone checking a change) also builds and tests against 18:

      dotnet test -p:UmbracoMajor=18

    These ranges override Directory.Packages.props for this package only (VersionOverride), so
    the rest of the monorepo stays pinned where it is.
  -->
  <PropertyGroup>
    <UmbracoMajor Condition="'$(UmbracoMajor)' == ''">17</UmbracoMajor>
  </PropertyGroup>

  <!-- Published package: floors are what Umbraco.Automate.Core 17.0.0 itself requires. -->
  <PropertyGroup Condition="'$(UmbracoMajor)' == '17'">
    <UmbracoCmsVersionRange>[17.4.0, 19.0.0)</UmbracoCmsVersionRange>
    <UmbracoAutomateVersionRange>[17.0.0, 19.0.0)</UmbracoAutomateVersionRange>
    <UmbracoAutomateTestingVersion>17.0.0</UmbracoAutomateTestingVersion>
  </PropertyGroup>

  <!-- Compatibility build: the current 18 releases. Never packed. -->
  <PropertyGroup Condition="'$(UmbracoMajor)' == '18'">
    <UmbracoCmsVersionRange>[18.2.0, 19.0.0)</UmbracoCmsVersionRange>
    <UmbracoAutomateVersionRange>[18.4.0, 19.0.0)</UmbracoAutomateVersionRange>
    <UmbracoAutomateTestingVersion>18.4.0</UmbracoAutomateTestingVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <Target Name="CheckUmbracoMajor" BeforeTargets="Restore;CollectPackageReferences"
          Condition="'$(UmbracoMajor)' != '17' And '$(UmbracoMajor)' != '18'">
    <Error Text="UmbracoMajor must be 17 or 18 (was '$(UmbracoMajor)')." />
  </Target>
</Project>
